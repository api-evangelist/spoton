{
  "opencollection": "1.0.0",
  "info": {
    "name": "SpotOn Reserve Availability Job Positions API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Job Positions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SpotOn List Job Positions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seatninja.com/locations/:locationId/job-positions",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the location."
              }
            ]
          },
          "docs": "Retrieve all job positions configured for a location."
        },
        {
          "info": {
            "name": "SpotOn Get Job Position",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seatninja.com/locations/:locationId/job-positions/:jobPositionId",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the location."
              },
              {
                "name": "jobPositionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the job position."
              }
            ]
          },
          "docs": "Retrieve a single job position by its unique identifier for a location."
        }
      ]
    }
  ],
  "bundled": true
}