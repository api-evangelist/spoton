          "name": "SpotOn List Time Clock Entries",
          "request": {
            "name": "SpotOn List Time Clock Entries",
            "description": {
              "content": "Retrieve all time clock entries for a location within a specified date/time range, filtered by update time, clock-in time, or clock-out time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locations",
                ":locationId",
                "time-clock-entries"
              ],
              "host": [
