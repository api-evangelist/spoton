                "locations",
                ":locationId",
                "paid-in-outs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "createdAtStart",
                  "value": "<dateTime>",
                  "description": "Inclusive RFC 3339 start of the creation range. Max 7-day range."
                },
                {
                  "disabled": false,
                  "key": "createdAtEnd",
                  "value": "<dateTime>",
                  "description": "Exclusive RFC 3339 end of the creation range. Must be at least 5 minutes in the past."
                }
