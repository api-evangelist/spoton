{
  "opencollection": "1.0.0",
  "info": {
    "name": "SpotOn Reserve Availability Restaurants API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Restaurants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SpotOn List Restaurants",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.seatninja.com/restaurants"
          },
          "docs": "List the restaurants accessible with the supplied API key."
        }
      ]
    }
  ],
  "bundled": true
}