        {
          "id": "2fb333e4-9396-4d5c-a723-39b0f0417944",
          "name": "SpotOn List Orders",
          "request": {
            "name": "SpotOn List Orders",
            "description": {
              "content": "Retrieve all orders that were last updated, created, or closed within the supplied date/time range for a location. Only orders touched within the last ~90 days are available, and a single date range cannot exceed 26 hours.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locations",
                ":locationId",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "updatedAtStart",
                  "value": "<dateTime>",
                  "description": "Inclusive RFC 3339 start of the update range. Max 26-hour range, no milliseconds."
                },
                {
                  "disabled": false,
                  "key": "updatedAtEnd",
                  "value": "<dateTime>",
                  "description": "Exclusive RFC 3339 end of the update range. Must be at least 5 minutes in the past."
                },
                {
                  "disabled": false,
                  "key": "createdAtStart",
                  "value": "<dateTime>",
                  "description": "Inclusive RFC 3339 start of the creation range. Max 26-hour range, no milliseconds."
                },
                {
                  "disabled": false,
                  "key": "createdAtEnd",
                  "value": "<dateTime>",
                  "description": "Exclusive RFC 3339 end of the creation range. Must be at least 5 minutes in the past."
                },
                {
                  "disabled": false,
                  "key": "closedAtStart",
                  "value": "<dateTime>",
                  "description": "Inclusive RFC 3339 start of the closure range. Max 26-hour range, no milliseconds."
                },
                {
                  "disabled": false,
                  "key": "closedAtEnd",
                  "value": "<dateTime>",
                  "description": "Exclusive RFC 3339 end of the closure range. Must be at least 5 minutes in the past."
                },
                {
                  "disabled": false,
                  "key": "includeUpdatedActivity",
                  "value": "<boolean>",
                  "description": "Return previously created or closed orders that were subsequently updated. Only valid with createdAt or closedAt ranges."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "locationId",
                  "description": "(Required) The unique identifier for the location."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
